#!/usr/bin/env bash
# Encode the two pre-cleaned anime libraries outside Anvil's download queues.
#
# The command mirrors the Sonarr anime profile: QSV AV1, 10-bit, veryslow,
# VMAF 96, CRF 14..38, and a hard 1% saving threshold. It only replaces a
# source after ffprobe validation and an actual 1% size saving. The candidate
# lives on the SSD; publishing first copies it into the source directory, then
# atomically renames it over the original.
set -euo pipefail

readonly -a LIBRARIES=(
  "/tank/media/anime/Ghost in the Shell - Stand Alone Complex (2002) [tvdbid-73749]"
  "/tank/media/anime/Neon Genesis Evangelion (1995) [tvdbid-70350]"
)
readonly WORK_ROOT="${WORK_ROOT:-/var/lib/anvil/tmp/manual-anime-av1-qsv}"
readonly PRESET="veryslow"
readonly TARGET_VMAF=96
readonly MIN_SAVINGS_PERCENT=1
readonly MIN_CRF=14
readonly MAX_CRF=38
readonly THREADS=4

apply=false
limit=0

usage() {
  cat <<'EOF'
Usage: manual-anime-av1-qsv [--apply] [--limit COUNT]

Without --apply, list the files that would be considered. --limit is useful
for a single-file trial and applies only when --apply is present.
EOF
}

while (($#)); do
  case "$1" in
    --apply)
      apply=true
      ;;
    --limit)
      limit="${2:?--limit requires a count}"
      shift
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
  echo "--limit must be a non-negative integer" >&2
  exit 2
fi

anvil_tool() {
  local tool="$1"
  local service_environment service_path directory

  service_environment="$(systemctl show anvil.service --property=Environment --value)"
  service_path="$(sed -n 's/.* PATH=\([^ ]*\).*/\1/p' <<<"$service_environment")"
  if [[ -z "$service_path" ]]; then
    echo "Could not find Anvil's PATH" >&2
    exit 1
  fi

  local -a directories
  IFS=: read -r -a directories <<<"$service_path"
  for directory in "${directories[@]}"; do
    if [[ -x "$directory/$tool" ]]; then
      printf '%s\n' "$directory/$tool"
      return
    fi
  done

  echo "Could not find $tool in Anvil's PATH" >&2
  exit 1
}

readonly AB_AV1="$(anvil_tool ab-av1)"
readonly FFMPEG="$(anvil_tool ffmpeg)"
readonly FFPROBE="$(anvil_tool ffprobe)"

video_title() {
  local width height transfer inferred_height best_height candidate delta best_delta range
  IFS=, read -r width height transfer < <(
    "$FFPROBE" -v error -select_streams v:0 \
      -show_entries stream=width,height,color_transfer -of csv=p=0 "$1"
  )

  inferred_height=$(((width * 9 + 8) / 16))
  if ((inferred_height > height)); then
    height="$inferred_height"
  fi

  best_height=4320
  best_delta=$((height - best_height))
  ((best_delta < 0)) && best_delta=$((-best_delta))
  for candidate in 2160 1080 720 576 480 360; do
    delta=$((height - candidate))
    ((delta < 0)) && delta=$((-delta))
    if ((delta < best_delta)); then
      best_height="$candidate"
      best_delta="$delta"
    fi
  done

  case "${transfer,,}" in
    "")
      range=""
      ;;
    arib-std-b67)
      range="HLG"
      ;;
    smpte2084|smpte2084-10)
      range="HDR10"
      ;;
    *)
      range="SDR"
      ;;
  esac

  printf '%sp%s AV1\n' "$best_height" "${range:+ $range}"
}

stream_signature() {
  "$FFPROBE" -v error -show_entries stream=codec_type -of csv=p=0 "$1" | tr '\n' ','
}

duration_matches() {
  local source_duration output_duration
  source_duration="$("$FFPROBE" -v error -show_entries format=duration -of default=nw=1:nk=1 "$1")"
  output_duration="$("$FFPROBE" -v error -show_entries format=duration -of default=nw=1:nk=1 "$2")"
  awk -v source="$source_duration" -v output="$output_duration" 'BEGIN {
    delta = source - output
    if (delta < 0) delta = -delta
    exit(delta > 2)
  }'
}

record() {
  printf '%s\t%s\t%s\n' "$(date --iso-8601=seconds)" "$1" "$2" \
    | tee -a "$WORK_ROOT/results.tsv"
}

encode_file() {
  local source="$1"
  local codec decoder source_size source_mtime source_signature output_signature
  local work search_dir search_log candidate crf candidate_size max_candidate_size title
  local publish_dir publish

  codec="$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=codec_name -of default=nw=1:nk=1 "$source")"
  case "$codec" in
    av1)
      record "skipped" "$source (already AV1)"
      return
      ;;
    h264|hevc)
      decoder="${codec}_qsv"
      ;;
    *)
      record "skipped" "$source (unsupported video codec: $codec)"
      return
      ;;
  esac

  source_size="$(stat -c '%s' "$source")"
  source_mtime="$(stat -c '%Y' "$source")"
  source_signature="$(stream_signature "$source")"
  work="$WORK_ROOT/$(printf '%s' "$source" | sha256sum | cut -d ' ' -f 1)"
  search_dir="$work/search"
  search_log="$work/crf-search.log"
  candidate="$work/output.mkv"
  mkdir -p "$search_dir"
  rm -f -- "$candidate"

  echo "Searching CRF: $source"
  if ! TMPDIR="$search_dir" TEMP="$search_dir" TMP="$search_dir" \
    XDG_CACHE_HOME="$search_dir/cache" "$AB_AV1" crf-search \
    --input "$source" \
    --encoder av1_qsv \
    --preset "$PRESET" \
    --pix-format yuv420p10le \
    --min-crf "$MIN_CRF" \
    --max-crf "$MAX_CRF" \
    --min-vmaf "$TARGET_VMAF" \
    --max-encoded-percent "$((100 - MIN_SAVINGS_PERCENT))" \
    --temp-dir "$search_dir" \
    --enc "threads=$THREADS" \
    --vmaf "n_threads=$THREADS" \
    --enc look_ahead=1 \
    --enc extbrc=1 \
    --enc look_ahead_depth=40 \
    --enc adaptive_i=1 \
    --enc adaptive_b=1 \
    --enc b_strategy=1 \
    --enc bf=7 >"$search_log" 2>&1; then
    if grep -Eqi 'failed to find a suitable crf|no suitable crf|no good crf|not worth (av1 )?encoding' "$search_log"; then
      record "skipped" "$source (no CRF meets VMAF/size constraints)"
      return
    fi
    record "failed" "$source (ab-av1 failed; see $search_log)"
    return 1
  fi

  crf="$(awk 'BEGIN { IGNORECASE = 1 } {
    if (match($0, /crf[^0-9]*[0-9]+/)) {
      value = substr($0, RSTART, RLENGTH)
      sub(/.*[^0-9]/, "", value)
      print value
      exit
    }
  }' "$search_log")"
  if [[ -z "$crf" ]]; then
    record "failed" "$source (could not parse CRF; see $search_log)"
    return 1
  fi

  title="$(video_title "$source")"
  echo "Encoding CRF $crf: $source"
  "$FFMPEG" -hide_banner -nostdin -y \
    -hwaccel qsv \
    -hwaccel_output_format qsv \
    -c:v "$decoder" \
    -i "$source" \
    -map '0:V?' \
    -map '0:a?' \
    -map '0:s?' \
    -map '0:t?' \
    -map_metadata 0 \
    -map_chapters 0 \
    -vf 'vpp_qsv=format=p010le' \
    -c:v av1_qsv \
    -global_quality "$crf" \
    -preset "$PRESET" \
    -look_ahead 1 \
    -extbrc 1 \
    -look_ahead_depth 40 \
    -adaptive_i 1 \
    -adaptive_b 1 \
    -b_strategy 1 \
    -bf 7 \
    -threads "$THREADS" \
    -metadata:s:v title= \
    -metadata:s:v:0 "title=$title" \
    -c:a copy \
    -c:s copy \
    -c:t copy \
    "$candidate"

  "$FFPROBE" -v error "$candidate" >/dev/null
  if [[ "$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=codec_name -of default=nw=1:nk=1 "$candidate")" != "av1" ]]; then
    record "failed" "$source (candidate is not AV1)"
    return 1
  fi
  output_signature="$(stream_signature "$candidate")"
  if [[ "$source_signature" != "$output_signature" ]]; then
    record "failed" "$source (stream layout changed)"
    return 1
  fi
  if ! duration_matches "$source" "$candidate"; then
    record "failed" "$source (duration differs by more than two seconds)"
    return 1
  fi

  candidate_size="$(stat -c '%s' "$candidate")"
  max_candidate_size=$((source_size * (100 - MIN_SAVINGS_PERCENT) / 100))
  if ((candidate_size > max_candidate_size)); then
    record "skipped" "$source (actual output misses the ${MIN_SAVINGS_PERCENT}% saving gate)"
    return
  fi
  if [[ "$(stat -c '%s' "$source")" != "$source_size" || "$(stat -c '%Y' "$source")" != "$source_mtime" ]]; then
    record "failed" "$source (source changed while encoding)"
    return 1
  fi

  publish_dir="$(dirname "$source")"
  publish="$(mktemp "$publish_dir/.manual-anime-av1.XXXXXX")"
  rm -- "$publish"
  mv -- "$candidate" "$publish"
  chmod --reference="$source" "$publish"
  touch -r "$source" "$publish"
  sync -f "$publish"
  mv -f -- "$publish" "$source"
  record "replaced" "$source (CRF $crf; $source_size -> $candidate_size bytes)"
}

mapfile -d '' -t sources < <(
  find "${LIBRARIES[@]}" -type f \( -iname '*.mkv' -o -iname '*.mp4' \) -print0 | sort -z
)

if ((${#sources[@]} == 0)); then
  echo "No media files found" >&2
  exit 1
fi

if ! $apply; then
  printf '%s\n' "${sources[@]}"
  printf '\nRun with --apply to process %d files.\n' "${#sources[@]}"
  exit 0
fi

mkdir -p "$WORK_ROOT"
exec 9>"$WORK_ROOT/.lock"
if ! flock -n 9; then
  echo "Another manual anime AV1 encode is already running" >&2
  exit 1
fi

processed=0
failed=0
for source in "${sources[@]}"; do
  if ((limit > 0 && processed >= limit)); then
    break
  fi
  ((processed += 1))
  if ! encode_file "$source"; then
    ((failed += 1))
  fi
done

printf 'Processed %d file(s); %d failed. Results: %s\n' "$processed" "$failed" "$WORK_ROOT/results.tsv"
((failed == 0))
